/* ================================
   Variáveis Globais
================================ */
:root {
    --bg: #f7fbff;
    --card: #fff;
    --text: #072033;
    --muted: #5b6b75;
    --accent: #0b6efd;
    --accent-2: #ff8a39;
    --radius: 12px;
    --container: 1100px;
}

/* ================================
   Reset e Base
================================ */
* {
    box-sizing: border-box;
}

body {
    font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.45;
}

.container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 1rem;
}

.container h2 {
    margin-top: 30px;
}

/* ================================
   Header / Navegação
================================ */
.header {
    background: #fff;
    border-bottom: 1px solid rgba(2, 6, 23, 0.06);
}

.header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .6rem 0;
    background-color: #0b6efd;
}

.brand img {
    height: 44px;
}

.nav {
    display: flex;
    gap: 1rem;
    align-items: center;
}

.nav a {
    text-decoration: none;
    color: white;
    font-weight: 600;
    padding: .4rem .6rem;
    border-radius: 8px;
}

/* ================================
   HERO
================================ */
.hero {
    padding: 2rem 0;
    background: linear-gradient(180deg, #fff 0%, #f1f8ff 100%);
}

.hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
}

.hero h1 {
    font-size: 2rem;
    margin: 0;
    color: var(--text);
}

.lead {
    color: var(--muted);
    margin: .5rem 0 1rem;
}

.hero-media img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(2, 6, 23, 0.07);
    display: block;
}

/* ================================
   GRID / CARDS
================================ */
.grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.card {
    background: var(--card);
    padding: 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(2, 6, 23, 0.05);
    margin-top: 50px;
}

.card img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
}

.card .card-body {
    padding: 1rem;
}

/* ================================
   Botões
================================ */
.btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: .6rem .9rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
}

/* ================================
   Formulários
================================ */
.form-field {
    margin-bottom: .6rem;
}

input,
select,
textarea {
    width: 100%;
    padding: .6rem;
    border-radius: 8px;
    border: 1px solid #e6edf3;
}

.form-actions {
    margin-top: 1rem;
}

/* ================================
   Footer
================================ */
.site-footer {
    margin-top: 2rem;
    padding: 1rem 0;
    text-align: center;
    color: var(--muted);
}

/* ================================
   Responsividade
================================ */
@media (min-width: 900px) {

    .hero-inner {
        grid-template-columns: 1fr 520px;
        gap: 2rem;
    }

    .grid {
        grid-template-columns: 1fr 1fr;
    }

    .hero h1 {
        font-size: 2.6rem;
    }
}
